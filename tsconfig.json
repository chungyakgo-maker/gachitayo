{
  // 웹앱 전체(화면 포함)와 테스트 타입 검사
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "vite-plugin-pwa/client"]
  },
  "include": ["src", "test"],
  // 보고서 생성은 Node 기능을 써서 따로 검사한다 (tsconfig.report.json)
  "exclude": ["test/report"]
}
